{
  "name": "gaussian-splat-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n frontend,backend -c blue,green \"npm run dev\" \"npm run backend\"",
    "dev": "vite",
    "backend": "source .venv/bin/activate && python server/main.py",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "test": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "rm -rf temp_uploads temp_outputs dist"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@sparkjsdev/spark": "^0.1.10",
    "@types/three": "^0.182.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
